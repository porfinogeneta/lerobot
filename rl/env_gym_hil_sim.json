{
    "env": {
        "name": "gym_hil",
        "task": "PandaPickCubeKeyboard-v0",
        "fps": 10,
        "robot": null,
        "teleop": null,
        "processor": {
            "control_mode": "keyboard",
            "random_block_position": false,
            "gripper": {
                "use_gripper": true,
                "gripper_penalty": -0.02
            },
            "reset": {
                "control_time_s": 3600.0,
                "fixed_reset_joint_positions": [
                    0.0,
                    0.195,
                    0.0,
                    -2.43,
                    0.0,
                    2.62,
                    0.785
                ]
            },
            "inverse_kinematics": {
                "end_effector_step_sizes": {
                    "x": 0.025,
                    "y": 0.025,
                    "z": 0.025
                }
            }
        },
        "features": {
            "observation.images.front": {
                "type": "VISUAL",
                "shape": [
                    3,
                    128,
                    128
                ]
            },
            "observation.images.wrist": {
                "type": "VISUAL",
                "shape": [
                    3,
                    128,
                    128
                ]
            },
            "observation.state": {
                "type": "STATE",
                "shape": [
                    18
                ]
            },
            "action": {
                "type": "ACTION",
                "shape": [
                    3
                ]
            }
        },
        "features_map": {
            "observation.images.front": "observation.images.front",
            "observation.images.wrist": "observation.images.wrist",
            "observation.state": "observation.state",
            "action": "action"
        }
    },
    "dataset": {
        "repo_id": "szymmon/cube_pickup_all_same",
        "root": null,
        "task": "pick_cube",
        "num_episodes_to_record": 1,
        "replay_episode": null,
        "push_to_hub": true
    },
    "device": "mps",
    "mode": "record"
}
